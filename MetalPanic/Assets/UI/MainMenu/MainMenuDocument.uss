.main-menu-root {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    align-items: center;
    justify-content: center;
    color: rgb(225, 235, 241);
    -unity-font-style: bold;
}

.main-menu-background {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    background-image: url("MainMenuBackground.png");
    -unity-background-scale-mode: scale-and-crop;
}

.background-shade {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    background-color: rgba(0, 0, 0, 0.5);
}

.main-menu-panel {
    width: 76%;
    max-width: 1040px;
    min-width: 680px;
    max-height: 84%;
    padding-left: 22px;
    padding-right: 22px;
    padding-top: 18px;
    padding-bottom: 18px;
    background-color: rgba(7, 12, 22, 0.82);
    border-left-width: 1px;
    border-right-width: 1px;
    border-top-width: 1px;
    border-bottom-width: 1px;
    border-left-color: rgba(92, 210, 255, 0.22);
    border-right-color: rgba(92, 210, 255, 0.22);
    border-top-color: rgba(255, 208, 71, 0.28);
    border-bottom-color: rgba(92, 210, 255, 0.22);
    border-top-left-radius: 6px;
    border-top-right-radius: 6px;
    border-bottom-left-radius: 6px;
    border-bottom-right-radius: 6px;
}

.frame-top,
.frame-bottom {
    height: 12px;
    flex-direction: row;
    align-items: center;
}

.frame-bottom {
    margin-top: 20px;
}

.frame-corner {
    width: 8px;
    height: 8px;
    border-left-width: 2px;
    border-right-width: 2px;
    border-top-width: 2px;
    border-bottom-width: 2px;
    border-left-color: rgba(235, 244, 248, 0.7);
    border-right-color: rgba(235, 244, 248, 0.7);
    border-top-color: rgba(235, 244, 248, 0.7);
    border-bottom-color: rgba(235, 244, 248, 0.7);
}

.frame-line {
    flex-grow: 1;
    height: 2px;
    margin-left: 6px;
    margin-right: 6px;
    background-color: rgba(235, 244, 248, 0.7);
}

.menu-content {
    padding-left: 30px;
    padding-right: 30px;
    padding-top: 26px;
    padding-bottom: 0;
}

.logo-block {
    align-items: center;
    justify-content: center;
}

.main-menu-logo {
    width: 560px;
    height: 244px;
    background-image: url("MainMenuLogo.png");
    -unity-background-scale-mode: scale-to-fit;
}

.version-label {
    margin-top: -18px;
    align-self: center;
    font-size: 15px;
    color: rgba(225, 235, 241, 0.76);
}

.main-columns {
    margin-top: 30px;
    flex-direction: row;
}

.main-column {
    flex-grow: 1;
    min-width: 0;
}

.menu-column {
    padding-right: 30px;
}

.leaderboard-column {
    padding-left: 30px;
}

.column-divider {
    width: 2px;
    background-color: rgba(235, 244, 248, 0.52);
}

.column-title {
    font-size: 18px;
    color: rgb(212, 225, 233);
}

.menu-box {
    margin-top: 18px;
    padding-left: 36px;
    padding-right: 36px;
    padding-top: 28px;
    padding-bottom: 28px;
    background-color: rgba(4, 9, 20, 0.48);
    border-left-width: 2px;
    border-right-width: 2px;
    border-top-width: 2px;
    border-bottom-width: 2px;
    border-left-color: rgba(235, 244, 248, 0.46);
    border-right-color: rgba(235, 244, 248, 0.46);
    border-top-color: rgba(235, 244, 248, 0.46);
    border-bottom-color: rgba(235, 244, 248, 0.46);
}

.main-menu-button {
    height: 42px;
    margin-bottom: 22px;
    background-color: rgba(4, 11, 25, 0.52);
    border-left-width: 1px;
    border-right-width: 1px;
    border-top-width: 1px;
    border-bottom-width: 1px;
    border-left-color: rgba(92, 210, 255, 0.34);
    border-right-color: rgba(92, 210, 255, 0.34);
    border-top-color: rgba(255, 208, 71, 0.36);
    border-bottom-color: rgba(92, 210, 255, 0.34);
    color: rgb(228, 238, 244);
    font-size: 16px;
    -unity-text-align: middle-center;
}

.main-menu-button:hover {
    background-color: rgba(22, 44, 70, 0.78);
    border-left-color: rgba(255, 208, 71, 0.68);
    border-right-color: rgba(255, 208, 71, 0.68);
    border-top-color: rgba(255, 208, 71, 0.86);
    border-bottom-color: rgba(255, 208, 71, 0.68);
    color: rgb(255, 226, 92);
}

.main-menu-button:active {
    background-color: rgba(255, 206, 55, 0.2);
}

.play-button {
    border-left-color: rgba(62, 222, 255, 0.5);
}

.guide-button {
    border-left-color: rgba(255, 206, 55, 0.5);
}

.quit-button {
    margin-bottom: 0;
    border-left-color: rgba(255, 82, 56, 0.5);
}

.leaderboard-table {
    margin-top: 18px;
    padding-left: 18px;
    padding-right: 18px;
    padding-top: 14px;
    padding-bottom: 14px;
    background-color: rgba(4, 9, 20, 0.52);
    border-left-width: 2px;
    border-right-width: 2px;
    border-top-width: 2px;
    border-bottom-width: 2px;
    border-left-color: rgba(235, 244, 248, 0.46);
    border-right-color: rgba(235, 244, 248, 0.46);
    border-top-color: rgba(235, 244, 248, 0.46);
    border-bottom-color: rgba(235, 244, 248, 0.46);
}

.leaderboard-row {
    height: 32px;
    flex-direction: row;
    align-items: center;
}

.rank-cell {
    width: 54px;
    font-size: 16px;
    color: rgb(192, 210, 222);
}

.name-cell {
    flex-grow: 1;
    font-size: 16px;
    color: rgb(231, 239, 244);
}

.points-cell {
    width: 126px;
    font-size: 16px;
    color: rgb(255, 213, 92);
    -unity-text-align: middle-right;
}

.leaderboard-status {
    margin-top: 14px;
    align-self: center;
    font-size: 14px;
    color: rgba(225, 235, 241, 0.66);
}

@media (min-width: 2200px) {
    .main-menu-panel {
        max-width: 980px;
    }

    .main-menu-logo {
        width: 510px;
        height: 222px;
    }

    .column-title {
        font-size: 16px;
    }

    .main-menu-button,
    .rank-cell,
    .name-cell,
    .points-cell {
        font-size: 14px;
    }
}

@media (max-width: 1280px) {
    .main-menu-panel {
        width: 86%;
        min-width: 600px;
    }

    .menu-content {
        padding-left: 20px;
        padding-right: 20px;
    }

    .main-menu-logo {
        width: 460px;
        height: 200px;
    }

    .main-columns {
        margin-top: 24px;
    }

    .column-title {
        font-size: 15px;
    }

    .main-menu-button,
    .rank-cell,
    .name-cell,
    .points-cell {
        font-size: 13px;
    }
}

@media (max-width: 900px) {
    .main-menu-panel {
        width: 94%;
        min-width: 0;
        padding-left: 14px;
        padding-right: 14px;
    }

    .menu-content {
        padding-left: 10px;
        padding-right: 10px;
        padding-top: 18px;
    }

    .main-menu-logo {
        width: 340px;
        height: 148px;
    }

    .version-label {
        margin-top: -8px;
        font-size: 11px;
    }

    .main-columns {
        flex-direction: column;
        margin-top: 20px;
    }

    .menu-column {
        padding-right: 0;
    }

    .leaderboard-column {
        padding-left: 0;
        margin-top: 24px;
    }

    .column-divider {
        display: none;
    }
}

@media (max-height: 720px) {
    .main-menu-panel {
        max-height: 94%;
        padding-top: 10px;
        padding-bottom: 10px;
    }

    .menu-content {
        padding-top: 10px;
    }

    .main-menu-logo {
        width: 300px;
        height: 130px;
    }

    .version-label {
        margin-top: -6px;
    }

    .main-columns {
        margin-top: 16px;
    }

    .menu-box {
        padding-top: 16px;
        padding-bottom: 16px;
    }

    .main-menu-button {
        height: 34px;
        margin-bottom: 12px;
    }

    .leaderboard-row {
        height: 26px;
    }
}
