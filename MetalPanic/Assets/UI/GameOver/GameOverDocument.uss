.gameover-root {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    align-items: center;
    justify-content: center;
    color: rgb(225, 235, 241);
    -unity-font-style: bold;
}

.screen-dim {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    background-color: rgba(0, 0, 0, 0.44);
}

.gameover-panel {
    width: 66%;
    max-width: 900px;
    min-width: 560px;
    max-height: 86%;
    padding-left: 20px;
    padding-right: 20px;
    padding-top: 18px;
    padding-bottom: 18px;
    background-color: rgba(7, 12, 22, 0.84);
    border-left-width: 1px;
    border-right-width: 1px;
    border-top-width: 1px;
    border-bottom-width: 1px;
    border-left-color: rgba(92, 210, 255, 0.22);
    border-right-color: rgba(92, 210, 255, 0.22);
    border-top-color: rgba(255, 208, 71, 0.28);
    border-bottom-color: rgba(92, 210, 255, 0.22);
    border-top-left-radius: 6px;
    border-top-right-radius: 6px;
    border-bottom-left-radius: 6px;
    border-bottom-right-radius: 6px;
}

.frame-top,
.frame-bottom {
    height: 12px;
    flex-direction: row;
    align-items: center;
}

.frame-bottom {
    margin-top: 14px;
}

.frame-corner {
    width: 8px;
    height: 8px;
    border-left-width: 2px;
    border-right-width: 2px;
    border-top-width: 2px;
    border-bottom-width: 2px;
    border-left-color: rgba(235, 244, 248, 0.7);
    border-right-color: rgba(235, 244, 248, 0.7);
    border-top-color: rgba(235, 244, 248, 0.7);
    border-bottom-color: rgba(235, 244, 248, 0.7);
}

.frame-line {
    flex-grow: 1;
    height: 2px;
    margin-left: 6px;
    margin-right: 6px;
    background-color: rgba(235, 244, 248, 0.7);
}

.panel-content {
    padding-left: 34px;
    padding-right: 34px;
    padding-top: 18px;
    padding-bottom: 8px;
    align-items: center;
}

.result-header {
    flex-direction: row;
    align-items: center;
    justify-content: center;
}

.warning-mark {
    width: 22px;
    height: 22px;
    border-top-left-radius: 11px;
    border-top-right-radius: 11px;
    border-bottom-left-radius: 11px;
    border-bottom-right-radius: 11px;
    background-color: rgb(255, 205, 45);
    border-left-width: 2px;
    border-right-width: 2px;
    border-top-width: 2px;
    border-bottom-width: 2px;
    border-left-color: rgb(255, 92, 48);
    border-right-color: rgb(255, 92, 48);
    border-top-color: rgb(255, 92, 48);
    border-bottom-color: rgb(255, 92, 48);
}

.warning-mark-text {
    font-size: 14px;
    color: rgb(39, 15, 12);
    -unity-text-align: middle-center;
}

.gameover-title {
    margin-left: 12px;
    margin-right: 12px;
    font-size: 22px;
    color: rgb(238, 244, 248);
    -unity-text-outline-width: 1px;
    -unity-text-outline-color: rgba(0, 0, 0, 0.82);
}

.summary-stack {
    margin-top: 14px;
    align-items: center;
}

.summary-line {
    height: 28px;
    flex-direction: row;
    align-items: center;
    justify-content: center;
}

.summary-label {
    font-size: 17px;
    color: rgb(181, 198, 210);
    margin-right: 10px;
}

.summary-value {
    font-size: 18px;
    color: rgb(232, 241, 246);
    -unity-text-outline-width: 1px;
    -unity-text-outline-color: rgba(0, 0, 0, 0.72);
}

.score-value {
    color: rgb(255, 213, 92);
}

.leaderboard-block {
    margin-top: 30px;
    width: 70%;
    min-width: 430px;
    max-width: 610px;
    align-items: center;
}

.section-title-row {
    width: 100%;
    height: 26px;
    flex-direction: row;
    align-items: center;
}

.section-rule {
    flex-grow: 1;
    height: 2px;
    background-color: rgba(235, 244, 248, 0.58);
}

.section-title {
    margin-left: 14px;
    margin-right: 14px;
    font-size: 16px;
    color: rgb(212, 225, 233);
}

.leaderboard-table {
    width: 100%;
    margin-top: 12px;
    padding-left: 14px;
    padding-right: 14px;
    padding-top: 10px;
    padding-bottom: 10px;
    background-color: rgba(4, 9, 20, 0.52);
    border-left-width: 2px;
    border-right-width: 2px;
    border-top-width: 2px;
    border-bottom-width: 2px;
    border-left-color: rgba(235, 244, 248, 0.46);
    border-right-color: rgba(235, 244, 248, 0.46);
    border-top-color: rgba(235, 244, 248, 0.46);
    border-bottom-color: rgba(235, 244, 248, 0.46);
}

.leaderboard-row {
    height: 30px;
    flex-direction: row;
    align-items: center;
}

.player-row {
    background-color: rgba(255, 206, 55, 0.12);
    border-left-width: 3px;
    border-left-color: rgb(255, 206, 55);
}

.rank-cell {
    width: 54px;
    font-size: 16px;
    color: rgb(192, 210, 222);
    -unity-text-align: middle-left;
}

.name-cell {
    flex-grow: 1;
    font-size: 16px;
    color: rgb(231, 239, 244);
}

.points-cell {
    width: 124px;
    font-size: 16px;
    color: rgb(255, 213, 92);
    -unity-text-align: middle-right;
}

.highlight-tag {
    width: 104px;
    margin-left: 14px;
    font-size: 13px;
    color: rgb(62, 222, 255);
    -unity-text-align: middle-left;
}

.action-row {
    margin-top: 34px;
    width: 68%;
    min-width: 420px;
    max-width: 620px;
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
}

.gameover-button {
    width: 220px;
    height: 38px;
    padding-left: 14px;
    padding-right: 14px;
    background-color: rgba(4, 11, 25, 0.52);
    border-left-width: 1px;
    border-right-width: 1px;
    border-top-width: 1px;
    border-bottom-width: 1px;
    border-left-color: rgba(92, 210, 255, 0.34);
    border-right-color: rgba(92, 210, 255, 0.34);
    border-top-color: rgba(255, 208, 71, 0.36);
    border-bottom-color: rgba(92, 210, 255, 0.34);
    color: rgb(228, 238, 244);
    font-size: 15px;
    -unity-text-align: middle-center;
}

.gameover-button:hover {
    background-color: rgba(22, 44, 70, 0.78);
    border-left-color: rgba(255, 208, 71, 0.68);
    border-right-color: rgba(255, 208, 71, 0.68);
    border-top-color: rgba(255, 208, 71, 0.86);
    border-bottom-color: rgba(255, 208, 71, 0.68);
    color: rgb(255, 226, 92);
}

.gameover-button:active {
    background-color: rgba(255, 206, 55, 0.2);
}

.retry-button {
    border-left-color: rgba(62, 222, 255, 0.5);
}

.menu-button {
    border-left-color: rgba(255, 206, 55, 0.5);
}

@media (min-width: 2200px) {
    .gameover-panel {
        max-width: 820px;
    }

    .gameover-title {
        font-size: 20px;
    }

    .summary-label,
    .summary-value {
        font-size: 16px;
    }

    .leaderboard-block {
        max-width: 560px;
    }

    .action-row {
        max-width: 560px;
    }
}

@media (max-width: 1400px) {
    .gameover-panel {
        width: 72%;
        min-width: 520px;
    }

    .panel-content {
        padding-left: 24px;
        padding-right: 24px;
    }

    .leaderboard-block {
        width: 76%;
        min-width: 400px;
    }

    .action-row {
        width: 74%;
        min-width: 400px;
    }
}

@media (max-width: 1100px) {
    .gameover-panel {
        width: 86%;
        min-width: 0;
        padding-left: 14px;
        padding-right: 14px;
        padding-top: 12px;
        padding-bottom: 12px;
    }

    .panel-content {
        padding-left: 12px;
        padding-right: 12px;
        padding-top: 12px;
    }

    .gameover-title {
        font-size: 18px;
    }

    .summary-line {
        height: 24px;
    }

    .summary-label,
    .summary-value {
        font-size: 14px;
    }

    .leaderboard-block {
        width: 88%;
        min-width: 0;
        margin-top: 22px;
    }

    .rank-cell {
        width: 42px;
        font-size: 13px;
    }

    .name-cell {
        font-size: 13px;
    }

    .points-cell {
        width: 96px;
        font-size: 13px;
    }

    .highlight-tag {
        display: none;
    }

    .action-row {
        width: 88%;
        min-width: 0;
        margin-top: 24px;
    }

    .gameover-button {
        width: 180px;
        height: 34px;
        font-size: 13px;
    }
}

@media (max-width: 760px) {
    .gameover-panel {
        width: 94%;
    }

    .summary-line {
        flex-direction: column;
        height: 42px;
    }

    .summary-label {
        margin-right: 0;
        font-size: 11px;
    }

    .summary-value {
        font-size: 14px;
    }

    .leaderboard-table {
        padding-left: 8px;
        padding-right: 8px;
    }

    .action-row {
        flex-direction: column;
    }

    .gameover-button {
        width: 100%;
        margin-bottom: 8px;
    }
}

@media (max-height: 720px) {
    .gameover-panel {
        max-height: 94%;
        padding-top: 10px;
        padding-bottom: 10px;
    }

    .panel-content {
        padding-top: 8px;
        padding-bottom: 4px;
    }

    .summary-stack {
        margin-top: 8px;
    }

    .leaderboard-block {
        margin-top: 14px;
    }

    .leaderboard-row {
        height: 24px;
    }

    .action-row {
        margin-top: 16px;
    }

    .frame-bottom {
        margin-top: 8px;
    }
}
